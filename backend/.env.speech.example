ENVIRONMENT=local
PORT=9000

# Required unless ENVIRONMENT is local or test: the internal inference socket
# refuses to start without it. Must match SPEECH_SERVICE_TOKEN on the gateway.
SPEECH_SERVICE_TOKEN=

# --- Speech-to-text -----------------------------------------------------------
# large-v3-turbo is a distilled large-v3. It handles Vietnamese mixed with
# English technical terms (ONNX, TensorRT, INT8) far better than `medium`, which
# mangled them badly enough that scoring graded transcription errors instead of
# the candidate.
#
# VRAM measured on an RTX 3050 Ti (4 GB), STT and TTS resident together:
#   large-v3-turbo + int8_float16   ~1.0 GB   <- recommended for 4 GB cards
#   large-v3-turbo + float16        ~1.6 GB
#   VieNeu-TTS v3turbo (cuda)       ~0.7 GB
# Total at the recommended setting is ~1.7 GB, leaving ~1.5 GB headroom.
#
# On CPU use STT_COMPUTE_TYPE=int8 instead; int8_float16 needs CUDA.
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_LANGUAGE=vi
STT_VOCABULARY_PROFILE=auto

# Audio buffer between the socket and the recogniser, in 512-sample frames.
# 800 frames is ~25 s for well under 1 MB. The old default of 64 (~2 s) could not
# absorb a single transcription pass, so any normal answer overflowed it.
STT_AUDIO_QUEUE_SIZE=800

# How often to emit an interim transcript. Every partial re-transcribes the
# utterance so far, so a short interval asks the GPU for more than it can do.
STT_PARTIAL_INTERVAL_MS=2500

# Past this much buffered speech, stop emitting partials and save the GPU for
# the final transcript, which is the one that gets scored.
STT_PARTIAL_MAX_AUDIO_MS=20000

# Beam width for the final transcript only; partials always run greedy.
STT_FINAL_BEAM_SIZE=2

# --- Voice activity detection -------------------------------------------------
# 500 ms endpointed on ordinary mid-sentence pauses and cut answers in half.
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=900
VAD_SPEECH_PAD_MS=120

# --- Text-to-speech -----------------------------------------------------------
# TTS_PROVIDER is currently unused by the gateway (it hardcodes VieNeu for the
# in-process path). It is wired in speech_service/dependencies.py and kept here
# for documentation; switch to "azure" to use Azure TTS in the speech service.
TTS_PROVIDER=vieneu
TTS_MODE=v3turbo
TTS_DEVICE=cuda
TTS_SAMPLE_RATE=24000
# Optional and process-local. Keep false when fast local process startup matters;
# enable in a long-running production speech process to warm VieNeu in the
# background during startup, before the first real interviewer message.
TTS_PREWARM=false

# --- Optional Azure Speech provider ------------------------------------------
# When STT_PROVIDER=azure the live interview uses Azure Speech-to-Text instead
# of local faster-whisper; when TTS_PROVIDER=azure it uses Azure Text-to-Speech
# instead of VieNeu. Leave unset to keep the default local engines.
#
# STT_PROVIDER=faster_whisper
# TTS_PROVIDER=vieneu
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_ENDPOINT=
# AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
# AZURE_STT_LANGUAGE=vi-VN
