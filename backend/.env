ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

GOOGLE_CLOUD_PROJECT=project-7dffc340-f73f-4e62-aec
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_SIMPLE_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_LOCATION=global
INTERVIEW_PREPARATION_TTL_SECONDS=300
INTERVIEW_PREPARATION_MAX_ENTRIES=128

AUTH_ENABLED=false
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=project-7dffc340-f73f-4e62-aec

REPOSITORY_BACKEND=sqlite
FIRESTORE_DATABASE=(default)

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5179,http://127.0.0.1:5179

SPEECH_MODE=in-process
# SPEECH_SERVICE_URL=http://localhost:9000
# Must match SPEECH_SERVICE_TOKEN in backend/.env.speech. Optional only while
# ENVIRONMENT is local or test.
SPEECH_SERVICE_TOKEN=

# These matter only when SPEECH_SERVICE_URL is unset (in-process speech). With a
# remote speech service, backend/.env.speech is what governs the models.
# STT_AUDIO_QUEUE_SIZE still applies here: it sizes the gateway-side buffer that
# forwards audio to the speech service.
STT_PROVIDER=azure
STT_MODEL=large-v3-turbo
STT_LANGUAGE=vi
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_AUDIO_QUEUE_SIZE=800
STT_PARTIAL_INTERVAL_MS=2500
VAD_MIN_SILENCE_MS=900

TTS_PROVIDER=azure
# Used only when SPEECH_SERVICE_URL is empty. Optional TTS prewarm never blocks
# gateway readiness and does not synthesize interview questions.
TTS_PREWARM=false

# --- LLM provider selection ---
# Set LLM_PROVIDER=azure to route all LLM calls through an OpenAI-compatible
# endpoint (e.g. Azure OpenAI) instead of Google Vertex AI. Requires
# AZURE_OPENAI_BASE_URL and AZURE_OPENAI_API_KEY. Values below mirror the
# azure_openai block in fipilot-v1/backend/fipilot/configs/config.yaml.
LLM_PROVIDER=azure
AZURE_OPENAI_BASE_URL=https://hoai-openai-test-2026-55ac1.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt41mini
AZURE_OPENAI_SIMPLE_DEPLOYMENT=gpt41mini
AZURE_OPENAI_COMPLEX_DEPLOYMENT=gpt41mini
AZURE_FOUNDRY_ENDPOINT=https://nguyenhuuhoai0905-8800-resource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY="2I6U8leeX0fB1aV3fyo4BwYP4NihOJ331msbQJGwAGfmO1YgwARCJQQJ99CHACF24PCXJ3w3AAAAACOGxayF"
AZURE_EMBEDDING_MODEL=text-embedding-3-small
AZURE_SPEECH_KEY=8zsI1KzrZpQsmtUvDYfFxV3lN6adUdUPblLGU0t5HvbaWPA3pL7bJQQJ99CHACGhslBXJ3w3AAAAACOGGYke
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_VOICE=en-US-Harper:MAI-Voice-2
DATABASE_URL=sqlite:///./interview_app.db
AZURE_OPENAI_API_KEY="1rP82XkUywkk9EuZP3vNsADwiu1mt3K6GS284fQGybe9JJlEofPjJQQJ99CHACF24PCXJ3w3AAABACOGuiL6"
