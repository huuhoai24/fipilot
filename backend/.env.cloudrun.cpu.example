APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_SIMPLE_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
# Answer evaluation and report generation use the stronger Gemini route.
EVALUATOR_TASK_TYPE=complex
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_LOCATION=global

AUTH_ENABLED=true
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-google-cloud-project
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

REPOSITORY_BACKEND=firestore
FIRESTORE_DATABASE=(default)

# The Cloud Run image bakes this model at build time. Do not use the remote
# model alias here or cold instances will attempt a Hugging Face download.
STT_MODEL=/opt/fipilot/models/faster-whisper-large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=vi

TTS_MODE=v3turbo
TTS_DEVICE=cpu
TTS_PREWARM=true

# Keep inference in this application container for this benchmark.
SPEECH_SERVICE_URL=
SPEECH_BENCHMARK_MODE=true
SPEECH_PREWARM_MODELS=true
