# Copy this file to backend/.env before running an AI Lab command.
# Never commit backend/.env or a Google service-account JSON key.
# Authenticate locally with: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Production-compatible default model routes. Override them here for all Lab
# runs, or use --model for a one-off experiment.
GEMINI_SIMPLE_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_LOCATION=global
EVALUATOR_TASK_TYPE=complex
