ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

GOOGLE_CLOUD_PROJECT=project-7dffc340-f73f-4e62-aec
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_SIMPLE_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_LOCATION=global
INTERVIEW_PREPARATION_TTL_SECONDS=300
INTERVIEW_PREPARATION_MAX_ENTRIES=128

AUTH_ENABLED=true
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=project-7dffc340-f73f-4e62-aec

REPOSITORY_BACKEND=firestore
FIRESTORE_DATABASE=(default)

CORS_ALLOWED_ORIGINS=http://localhost:5173

SPEECH_MODE=remote
SPEECH_SERVICE_URL=http://localhost:9000
# Must match SPEECH_SERVICE_TOKEN in backend/.env.speech. Optional only while
# ENVIRONMENT is local or test.
SPEECH_SERVICE_TOKEN=

# These matter only when SPEECH_SERVICE_URL is unset (in-process speech). With a
# remote speech service, backend/.env.speech is what governs the models.
# STT_AUDIO_QUEUE_SIZE still applies here: it sizes the gateway-side buffer that
# forwards audio to the speech service.
STT_MODEL=large-v3-turbo
STT_LANGUAGE=vi
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_AUDIO_QUEUE_SIZE=800
STT_PARTIAL_INTERVAL_MS=2500
VAD_MIN_SILENCE_MS=900

TTS_PROVIDER=vieneu
# Used only when SPEECH_SERVICE_URL is empty. Optional TTS prewarm never blocks
# gateway readiness and does not synthesize interview questions.
TTS_PREWARM=false
