# AI Interview Platform Backend Environment
#
# Copy this file to backend/.env and adjust values.
# Do not commit your real .env.


# ---------------------------------------------------------------------------
# Model Server Mode - NO EXTERNAL API DEFAULT
# ---------------------------------------------------------------------------
# Recommended demo mode with your own Google Colab T4 model server:
#   STT_PROVIDER=remote
#   TTS_PROVIDER=remote
#   LLM_PROVIDER=remote
#   EVALUATOR_PROVIDER=remote
#
# Local machine mode, all on this machine:
#   STT_PROVIDER=local
#   TTS_PROVIDER=local
#   LLM_PROVIDER=local
#   EVALUATOR_PROVIDER=local

STT_PROVIDER=local
TTS_PROVIDER=local
LLM_PROVIDER=ollama
EVALUATOR_PROVIDER=ollama
ALLOW_API_FALLBACK=false


# ---------------------------------------------------------------------------
# Self-hosted Local/Colab Model Server
# ---------------------------------------------------------------------------
# Values are printed by docs/colab_t4_model_server.ipynb.
# Backend uses this URL for the Colab model server.

REMOTE_MODEL_URL=https://your-ngrok-url.ngrok-free.app
REMOTE_MODEL_TOKEN=demo-secret-change-me
# Keep blank so the Colab model server uses its default Hugging Face Qwen2.5 1.5B.
REMOTE_LLM_MODEL=


# ---------------------------------------------------------------------------
# Local STT With faster-whisper
# ---------------------------------------------------------------------------
# Used when STT_PROVIDER=local.
# CPU demo:
#   LOCAL_STT_DEVICE=cpu
#   LOCAL_STT_COMPUTE_TYPE=int8
#
# GPU:
#   LOCAL_STT_DEVICE=cuda
#   LOCAL_STT_COMPUTE_TYPE=float16

LOCAL_STT_MODEL=qbsmlabs/PhoWhisper-small
LOCAL_STT_DEVICE=cuda
LOCAL_STT_COMPUTE_TYPE=int8_float16
LOCAL_STT_BEAM_SIZE=3
LOCAL_STT_PRELOAD=true
LOCAL_STT_INITIAL_PROMPT=Day la cau tra loi phong van ky thuat bang tieng Viet co lan thuat ngu tieng Anh: AI Engineer, Backend Developer, Frontend Developer, Machine Learning, Deep Learning, Python, JavaScript, TypeScript, React, SQL, Docker, Kubernetes, API, REST API, LLM, RAG, FastAPI.

# Second-pass transcript repair. Uses the configured core LLM and a dynamic
# glossary built from the candidate role, template, and recent interview context.
TRANSCRIPT_CORRECTION_ENABLED=true
TRANSCRIPT_CORRECTION_MAX_CHARS=1200

# Local VieNeu-TTS. Keep CPU on 4GB VRAM so it does not compete with STT/LLM.
LOCAL_TTS_DEVICE=cpu
LOCAL_TTS_PRELOAD=true


# ---------------------------------------------------------------------------
# Legacy PhoWhisper Transformers Pipeline
# ---------------------------------------------------------------------------
# Keep false unless torchcodec/FFmpeg/PyTorch are known to match.

PHOWHISPER_ENABLED=false


# ---------------------------------------------------------------------------
# Disabled External API Providers
# ---------------------------------------------------------------------------
# Keep these blank when you want local/Colab-only execution.

STT_MODEL=
STT_API_KEY=
STT_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=


# ---------------------------------------------------------------------------
# Optional Groq Fallback
# ---------------------------------------------------------------------------
# Keep blank. Used only by older scripts or if ALLOW_API_FALLBACK=true.

GROQ_API_KEY=


# ---------------------------------------------------------------------------
# Disabled Core LLM API Provider
# ---------------------------------------------------------------------------
# Keep blank unless you intentionally switch to API mode.

CORE_MODEL=
CORE_API_KEY=
CORE_BASE_URL=


# ---------------------------------------------------------------------------
# Disabled Evaluator LLM API Provider
# ---------------------------------------------------------------------------
# Keep blank unless you intentionally switch to API mode.

EVALUATOR_MODEL=
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=


# ---------------------------------------------------------------------------
# CV Parser LLM
# ---------------------------------------------------------------------------
# Used by backend/cv_parser.py for LLM-based CV extraction.
# In fast demo mode this uses the Colab model server too.

CV_LLM_PROVIDER=ollama
OLLAMA_CV_MODEL=qwen2.5:1.5b
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TASK_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=2m

